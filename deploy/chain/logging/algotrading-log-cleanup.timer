[Unit]
Description=Minute check for two-day algoTrading diagnostic retention

[Timer]
# Second 37, not 00: the VPS loses CPU to other virtual machines at the top of each minute.
OnCalendar=*-*-* *:*:37 UTC
AccuracySec=1s
Persistent=true
Unit=algotrading-log-cleanup.service

[Install]
WantedBy=timers.target
