#!/usr/bin/env bash
# algoTrading chain launcher.
#
# Installed layout (ALGO_ROOT is "/" on the VPS, any folder locally):
#   chain/    this script, compose.yml, chain.env, monitor.py, logging/
#   config/   non-secret configuration     secrets/  credentials (0700)
#   data/     durable state                logs/     <service>/YYYYMMDD.log
#   reports/  generated outputs            backups/  YYYYMMDD_HHMMSS.tar.gz
#   releases/ image archives per version
#
# From the repository:   deploy/chain/algo install <root>   |   deploy/chain/algo build
# From an installation:  <root>/chain/algo help
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RECEIVER_PORT=5514

# Format of the durable state this version writes (data/ and data/live/: PostgreSQL tables,
# snapshot JSON, journals, request folders). Increase it when a change writes state that an
# older release would misread; "algo activate" then refuses to go back to an older release
# on that data (README "Releases"). Adding tables or optional JSON fields does not need it.
STATE_FORMAT=1

# Images a release carries. Compose runs the chain images as "<name>:chain"; every release
# also keeps "<name>:<version>" so earlier releases stay loadable for a rollback.
CHAIN_IMAGES=(algotrading-runtime algotrading-dash-api algotrading-dash-web)
BASE_IMAGES=(alpine:3.20 nats:2.10-alpine postgres:16-alpine)

usage() {
    cat <<'EOF'
Usage: algo <command> [service...]

  up [service...]       start everything, or only the given services (and what they need)
  down [service...]     stop everything (containers removed, data kept) or only the given services
  restart <service...>  restart services
  ps                    containers, log receiver and host monitor
  logs <service> [-n N] follow today's log file of one service
  show [service]        resolved compose configuration with secrets masked
  backup                stop, archive data/ into backups/, start again if it was running
  receiver start|stop   local log receiver (only where systemd does not run it)
  monitor start|stop    local host telemetry collector (only where systemd does not run it)
  releases              release folders in releases/, with the current and previous one
  rollback              activate the previous release again
  activate <release folder> [root]
                        verify a release, stop, back up data/, install it and start
                        (also runs from the release folder's own copy: <folder>/algo)

Repository only:
  install <root>        create or update an installation; never overwrites config/secrets/data
  build                 build the runtime and dashboard images used by chain.env
  release <folder>      save the built images and the source into <folder>/<version>/

Moving the older algotrading-paper stack into an installation: chain/migrate_paper.py --help

Services: data-init nats postgres market-data-init market-data strategy risk planner
          execution dash-api dash-web watchdog notifier
          MODE=paper: gateway sim-exchange      MODE=live: gateway-kraken
EOF
}

# ------------------------------------------------------------------ repository
repo_root() {
    local root
    root="$(cd "$SCRIPT_DIR/../.." && pwd)"
    [[ -f "$root/deploy/chain/compose.yml" && -d "$root/lib" ]] || {
        echo "ERROR: install/build must run from the repository copy (deploy/chain/algo)" >&2; exit 1; }
    printf '%s\n' "$root"
}

# Path of <root>/<name>; avoids "//data" when the root is "/".
under() {
    local root="$1" name="$2"
    if [[ "$root" == "/" ]]; then printf '/%s\n' "$name"; else printf '%s/%s\n' "$root" "$name"; fi
}

install_chain() {
    local root="${1:?Usage: algo install <root>}"
    local repo
    repo="$(repo_root)"
    [[ "$root" == /* ]] || { echo "ERROR: use an absolute root path" >&2; exit 1; }
    case "$root" in /mnt/*) echo "ERROR: use a Linux filesystem, not /mnt (PostgreSQL needs real ownership)" >&2; exit 1;; esac
    root="${root%/}"; [[ -n "$root" ]] || root="/"

    local chain config secrets data
    chain="$(under "$root" chain)"; config="$(under "$root" config)"
    secrets="$(under "$root" secrets)"; data="$(under "$root" data)"
    mkdir -p "$chain/logging" "$chain/systemd" "$chain/tools" "$config" "$secrets" "$data/telemetry" "$data/receiver" \
             "$(under "$root" logs)" "$(under "$root" reports)" "$(under "$root" backups)" "$(under "$root" releases)"
    chmod 0700 "$secrets"

    # Chain files always follow the repository version.
    cp "$repo/deploy/chain/compose.yml" "$repo/deploy/chain/compose.local.yml" "$repo/deploy/chain/algo" \
       "$repo/deploy/chain/monitor.py" "$repo/deploy/chain/comparison.py" "$repo/deploy/chain/migrate_paper.py" \
       "$repo/deploy/chain/README.md" "$chain/"
    find "$repo/deploy/chain/logging" -maxdepth 1 -type f -exec cp {} "$chain/logging/" \;
    cp "$repo"/deploy/chain/systemd/*.service "$chain/systemd/"
    # Public Kraken plan observation used by comparison.py (no account access), and the
    # read-only Kraken account monitor run by algotrading-kraken.service.
    cp "$repo/live_trading/kraken_shadow.py" "$repo/live_trading/shadow_observer.py" \
       "$repo/live_trading/readable_log.py" "$repo/live_trading/kraken_account.py" \
       "$repo/live_trading/kraken_account_monitor.py" "$repo/live_trading/kraken_portfolio_summary.py" "$chain/tools/"
    # Binance -> Kraken symbol table, release-owned like the files above. Same relative path
    # as in the repository, so tools/kraken_shadow.py finds it in both places.
    mkdir -p "$chain/config/venues/kraken_futures"
    cp "$repo/config/venues/kraken_futures/symbol_map.json" "$chain/config/venues/kraken_futures/"
    chmod 0755 "$chain/algo"

    # receiver: Docker sends logs to the host receiver (VPS, native Docker).
    # local: Docker Desktop cannot reach it; monitor.py copies the container logs.
    local log_mode=receiver
    if docker info --format '{{.OperatingSystem}}' 2>/dev/null | grep -q "Docker Desktop"; then log_mode=local; fi
    if [[ ! -f "$chain/chain.env" ]]; then
        cat > "$chain/chain.env" <<'EOF'
# Non-secret chain settings. Credentials live in <root>/secrets/chain.env.
MODE=paper
RUNTIME_IMAGE=algotrading-runtime:chain
DASH_API_IMAGE=algotrading-dash-api:chain
DASH_WEB_IMAGE=algotrading-dash-web:chain
# Files under <root>/config/strategies and <root>/config/portfolio.
STRATEGY_FILE=pure_rsi_quote_volume.json
PORTFOLIO_FILE=pure_rsi_equal_weight.json
# yes only for the one start after changing PORTFOLIO_FILE on a running chain (README).
RISK_ADOPT_PORTFOLIO_CONFIG=no
# Dashboard display of the RSI rules; keep equal to the strategy file.
RSI_ENTRY=80
RSI_EXIT=70
INITIAL_CASH=100000
COMMISSION_RATE=0.001
MARKET_WARMUP_DAYS=100
QUOTE_VOLUME_FROM=
# /data/comparison/comparison.json while the PAPER vs. fast-backtest study runs; empty hides it.
PAPER_COMPARISON_FILE=
DASHBOARD_PORT=8092
# TEST_FILE writes data/dashboard/notifier; TELEGRAM needs the bot settings in secrets.
NOTIFIER_SINK=TEST_FILE
# "kraken" starts kraken-notifier (Telegram for the read-only Kraken account monitor,
# host unit algotrading-kraken.service). Needs secrets/kraken_readonly.env and the bot settings.
# (MODE is added as a profile by ./algo; list only extra profiles here.)
COMPOSE_PROFILES=
KRAKEN_NOTIFIER_SINK=TELEGRAM
LOG_DEBUG=0
# MODE=live only (README "Switching to live"): Kraken USD balance at the switch, a new
# namespace after any reset of data/live, and enabled only for authorized real orders.
LIVE_INITIAL_CASH=
LIVE_ACCOUNT_NAMESPACE=
LIVE_ORDER_SUBMISSION=disabled
LIVE_DEAD_MANS_SWITCH_SECONDS=0
# Fee rate of the expected run in the Kraken LIVE comparison (taker, lowest tier).
LIVE_COMMISSION_RATE=0.0005
EOF
        echo "LOG_MODE=$log_mode" >> "$chain/chain.env"
        echo "Created $chain/chain.env (LOG_MODE=$log_mode)"
    elif ! grep -q '^LOG_MODE=' "$chain/chain.env"; then
        echo "LOG_MODE=$log_mode" >> "$chain/chain.env"
        echo "Added LOG_MODE=$log_mode to $chain/chain.env"
    fi

    # Configuration defaults are copied once; later edits stay in <root>/config.
    if [[ ! -d "$config/strategies" ]]; then cp -r "$repo/config/strategies" "$config/"; echo "Created $config/strategies"; fi
    if [[ ! -d "$config/portfolio" ]]; then cp -r "$repo/config/portfolio" "$config/"; echo "Created $config/portfolio"; fi
    # Kraken account warning thresholds. The monitor's journal is bound to them: after an
    # edit, move data/kraken_account aside (see README) so earlier observations are kept.
    if [[ ! -f "$config/kraken_account_policy.json" ]]; then
        cp "$repo/config/venues/kraken_futures/account_policy.json" "$config/kraken_account_policy.json"
        echo "Created $config/kraken_account_policy.json"
    fi
    if [[ ! -f "$config/market_data.json" ]]; then
        python3 - "$repo/deploy/live/market_data_config.json" "$config/market_data.json" <<'PY'
import json, sys
market = json.load(open(sys.argv[1]))
# PAPER stream; open(T+1) prices for the simulated exchange.
market.update(stream="ALGOTRADING_PAPER_RUNTIME", publish_paper_execution_prices=True)
open(sys.argv[2], "w").write(json.dumps(market, indent=2) + "\n")
PY
        echo "Created $config/market_data.json"
    fi

    if [[ ! -f "$secrets/chain.env" ]]; then
        (umask 077; python3 - "$secrets/chain.env" <<'PY'
import secrets, sys
open(sys.argv[1], "w").write(
    "# Generated once. Never print or commit this file.\n"
    f"POSTGRES_PASSWORD={secrets.token_hex(24)}\n"
    f"DASHBOARD_VIEWER_PASSWORD={secrets.token_hex(12)}\n"
    # OPERATOR login: Manual Control (sends orders). Leave empty to have no operator.
    f"DASHBOARD_OPERATOR_PASSWORD={secrets.token_hex(12)}\n"
    "DASHBOARD_TELEGRAM_BOT_TOKEN=\n"
    "DASHBOARD_TELEGRAM_CHAT_ID=\n")
PY
        )
        echo "Created $secrets/chain.env (dashboard viewer and operator passwords are inside)"
    fi
    echo "Installed chain in $root. Next: $chain/algo up"
}

build_images() {
    local repo
    repo="$(repo_root)"
    meson compile -C "$repo/build" -j 3 algotrading_market_data_service algotrading_strategy_service \
        algotrading_portfolio_risk_service algotrading_order_planner_service algotrading_execution_state_service \
        algotrading_exchange_gateway algotrading_simulated_exchange_service algotrading_historical_market_data_service \
        algotrading_research  # fast baseline used by comparison.py
    bash "$repo/deploy/live/build_runtime_bundle.sh" --paper
    docker build -t algotrading-runtime:chain "$repo/deploy/chain/.runtime_bundle"
    docker build -t algotrading-dash-api:chain "$repo/dashboard/dashboard-api"
    docker build -t algotrading-dash-web:chain --build-arg VITE_DASHBOARD_DATA_MODE=api \
        --build-arg VITE_DASHBOARD_API_BASE_URL=/api --build-arg VITE_DASHBOARD_API_TIMEOUT_MS=8000 "$repo/dashboard"
}

# One folder per release: built images, the source they came from, a manifest, this script
# and checksums. On the VPS: sudo /releases/<version>/algo activate /releases/<version> /
make_release() {
    local out="${1:?Usage: algo release <output folder>}"
    local repo version folder name ref refs=() images=()
    repo="$(repo_root)"
    version="$(date -u +%Y%m%d_%H%M%S)-$(git -C "$repo" rev-parse --short HEAD 2>/dev/null || echo nogit)"
    [[ -z "$(git -C "$repo" status --porcelain 2>/dev/null)" ]] || version="$version-dirty"
    folder="$out/$version"
    mkdir -p "$folder"
    # Saved under "<name>:<version>": loading the archive adds this version next to the
    # running ":chain" images without replacing them; activation moves ":chain" later.
    for name in "${CHAIN_IMAGES[@]}"; do docker tag "$name:chain" "$name:$version"; refs+=("$name:$version"); done
    docker save -o "$folder/images.tar" "${refs[@]}" "${BASE_IMAGES[@]}"
    for ref in "${refs[@]}" "${BASE_IMAGES[@]}"; do
        images+=("$ref $(docker image inspect -f '{{.Id}} {{.Architecture}}' "$ref")")
    done
    for ref in "${refs[@]}"; do docker image rm "$ref" >/dev/null; done   # removes only the extra tag here
    python3 - "$folder/release.json" "$version" "$(git -C "$repo" rev-parse HEAD 2>/dev/null || echo nogit)" \
        "$STATE_FORMAT" "${images[@]}" <<'PY'
import datetime, json, sys
path, version, commit, state_format, *images = sys.argv[1:]
manifest = {
    "version": version,
    "commit": commit,
    "created_at": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
    "state_format": int(state_format),
    "images": [dict(zip(("ref", "id", "architecture"), image.split())) for image in images],
}
open(path, "w").write(json.dumps(manifest, indent=2) + "\n")
PY
    # The release's own launcher, so "activate" works before anything is extracted.
    cp "$repo/deploy/chain/algo" "$folder/algo"
    chmod 0755 "$folder/algo"
    # Source = the committed tree (HEAD), or for a dirty release the working tree: tracked
    # files plus new files git does not ignore. Never ignored data, builds or credentials
    # (a plain tar of the folder packed ~1.8 GB of ignored data and replay runs).
    if [[ "$version" == *-dirty ]]; then
        (cd "$repo" && git ls-files -z --cached --others --exclude-standard \
            | while IFS= read -r -d '' path; do [[ -f "$path" ]] && printf '%s\0' "$path"; done \
            | tar --null -T - -czf "$folder/source.tar.gz")
    else
        git -C "$repo" archive --format=tar.gz -o "$folder/source.tar.gz" HEAD
    fi
    (cd "$folder" && sha256sum images.tar source.tar.gz release.json algo > SHA256SUMS)
    echo "Release written: $folder"
}

# ------------------------------------------------------------------- releases
# Install a release folder (in <root>/releases/) and start it:
#   1. checksums, image IDs and architecture; the data's state format must not be newer
#   2. load images.tar unless the release's images are already here (a rollback)
#   3. stop the chain, back up data/, install the release's chain files, point ":chain"
#      at its images, record current/previous, start
# Refused between 23:30 and 00:30 UTC: the daily candle, decisions and orders run then.
activate_release() {
    local folder="${1:?Usage: algo activate <release folder> [root]}" root="${2:-}"
    [[ -d "$folder" ]] || { echo "ERROR: no release folder $folder" >&2; exit 1; }
    folder="$(cd "$folder" && pwd)"
    if [[ -z "$root" ]]; then
        [[ -f "$SCRIPT_DIR/chain.env" ]] || { echo "ERROR: give the installation root: algo activate <release folder> <root>" >&2; exit 1; }
        root="$(cd "$SCRIPT_DIR/.." && pwd)"
    fi
    local version chain releases data
    version="$(basename "$folder")"
    chain="$(under "$root" chain)"; releases="$(under "$root" releases)"; data="$(under "$root" data)"
    [[ -f "$chain/chain.env" ]] || { echo "ERROR: $root is not an installed chain (algo install <root> first)" >&2; exit 1; }
    [[ "$folder" == "$releases/$version" ]] || {
        echo "ERROR: keep release folders in $releases/ (rollback looks for them there), not $folder" >&2; exit 1; }

    local minute
    minute=$((10#$(date -u +%H) * 60 + 10#$(date -u +%M)))
    if (( minute >= 23 * 60 + 30 || minute < 30 )); then
        echo "ERROR: no release changes between 23:30 and 00:30 UTC (daily candle and orders); try later" >&2; exit 1
    fi

    (cd "$folder" && sha256sum --quiet -c SHA256SUMS) || { echo "ERROR: checksum mismatch in $folder" >&2; exit 1; }

    # Compose must run exactly the ":chain" images this activation sets.
    local key expected
    for key in RUNTIME_IMAGE=algotrading-runtime DASH_API_IMAGE=algotrading-dash-api DASH_WEB_IMAGE=algotrading-dash-web; do
        expected="${key#*=}:chain"
        [[ "$(sed -n "s/^${key%%=*}=//p" "$chain/chain.env" | tail -n 1)" == "$expected" ]] || {
            echo "ERROR: chain.env must have ${key%%=*}=$expected (releases move the :chain tag)" >&2; exit 1; }
    done

    # Releases made before release.json (2026-10-13) carry ":chain" tags and no recorded
    # image IDs; they are checked by SHA256SUMS only and read state format 1.
    local release_format=1 entries=() entry ref id arch
    if [[ -f "$folder/release.json" ]]; then
        mapfile -t entries < <(python3 - "$folder/release.json" <<'PY'
import json, sys
manifest = json.load(open(sys.argv[1]))
print(manifest["state_format"])
for image in manifest["images"]:
    print(image["ref"], image["id"], image["architecture"])
PY
        )
        release_format="${entries[0]}"
        entries=("${entries[@]:1}")
    fi

    local data_format=1
    [[ ! -f "$data/STATE_FORMAT" ]] || data_format="$(cat "$data/STATE_FORMAT")"
    if (( release_format < data_format )); then
        echo "ERROR: data/ holds state format $data_format; release $version reads only format $release_format." >&2
        echo "       Going back needs the data backup taken before the newer release (README \"Releases\")." >&2
        exit 1
    fi

    local host_arch missing=0
    case "$(uname -m)" in x86_64) host_arch=amd64 ;; aarch64|arm64) host_arch=arm64 ;; *) host_arch="$(uname -m)" ;; esac
    for entry in "${entries[@]}"; do
        read -r ref id arch <<< "$entry"
        [[ "$arch" == "$host_arch" ]] || { echo "ERROR: $ref is built for $arch, this host is $host_arch" >&2; exit 1; }
        [[ "$(docker image inspect -f '{{.Id}}' "$ref" 2>/dev/null)" == "$id" ]] || missing=1
    done
    if (( ${#entries[@]} == 0 || missing )); then
        echo "Loading $folder/images.tar"
        local loaded
        loaded="$(docker load -i "$folder/images.tar")"
        if (( ${#entries[@]} == 0 )); then
            # Older release: its chain images arrive as ":chain"; keep them as "<name>:<version>" too.
            while read -r ref; do
                [[ "$ref" == algotrading-*:chain ]] || continue
                docker tag "$ref" "${ref%:chain}:$version"
                entries+=("${ref%:chain}:$version $(docker image inspect -f '{{.Id}} {{.Architecture}}' "$ref")")
            done < <(sed -n 's/^Loaded image: //p' <<< "$loaded")
            (( ${#entries[@]} == ${#CHAIN_IMAGES[@]} )) || {
                echo "ERROR: $folder/images.tar did not contain the ${#CHAIN_IMAGES[@]} chain images" >&2; exit 1; }
        fi
    fi
    for entry in "${entries[@]}"; do
        read -r ref id arch <<< "$entry"
        [[ "$(docker image inspect -f '{{.Id}}' "$ref" 2>/dev/null)" == "$id" ]] || {
            echo "ERROR: image $ref does not have the ID recorded in the release ($id)" >&2; exit 1; }
    done
    echo "Release $version verified: checksums, ${#entries[@]} images, state format $release_format (data: $data_format)"

    # From here the chain is stopped; a failure leaves it stopped with the backup on disk.
    "$chain/algo" down
    "$chain/algo" backup
    rm -rf "$folder/source"
    mkdir -p "$folder/source"
    tar -xzf "$folder/source.tar.gz" -C "$folder/source"
    bash "$folder/source/deploy/chain/algo" install "$root"
    for entry in "${entries[@]}"; do
        read -r ref id arch <<< "$entry"
        [[ "$ref" != algotrading-* ]] || docker tag "$id" "${ref%:*}:chain"
    done
    echo "$release_format" > "$data/STATE_FORMAT"

    local current=""
    [[ ! -f "$releases/current" ]] || current="$(cat "$releases/current")"
    if [[ "$current" != "$version" ]]; then
        [[ -z "$current" ]] || echo "$current" > "$releases/previous"
        echo "$version" > "$releases/current"
    fi
    echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) activated $version (was ${current:-unrecorded})" >> "$releases/history.log"

    "$chain/algo" up
    # Host units are not replaced automatically; say which ones changed.
    local unit installed
    for unit in "$chain"/systemd/*.service "$chain"/logging/*.service "$chain"/logging/*.timer; do
        installed="/etc/systemd/system/$(basename "$unit")"
        [[ -f "$unit" && -f "$installed" ]] || continue
        cmp -s "$unit" "$installed" || echo "NOTE: $installed differs from this release's $unit; copy it and run systemctl daemon-reload"
    done
    echo "Release $version is running. Previous: $(cat "$releases/previous" 2>/dev/null || echo none) (algo rollback)"
}

rollback_release() {
    local releases previous
    releases="$(under "$ALGO_ROOT" releases)"
    [[ -s "$releases/previous" ]] || { echo "ERROR: no previous release recorded in $releases/previous" >&2; exit 1; }
    previous="$(cat "$releases/previous")"
    echo "Rolling back from $(cat "$releases/current" 2>/dev/null || echo unrecorded) to $previous"
    activate_release "$releases/$previous" "$ALGO_ROOT"
}

list_releases() {
    local releases current previous folder version mark
    releases="$(under "$ALGO_ROOT" releases)"
    current="$(cat "$releases/current" 2>/dev/null || true)"
    previous="$(cat "$releases/previous" 2>/dev/null || true)"
    for folder in "$releases"/*/; do
        [[ -d "$folder" ]] || continue
        version="$(basename "$folder")"
        mark=""
        [[ "$version" != "$current" ]] || mark="  <- current"
        [[ "$version" != "$previous" ]] || mark="  <- previous (algo rollback)"
        printf '%-40s %6s%s\n' "$version" "$(du -sh "$folder" 2>/dev/null | cut -f1)" "$mark"
    done
    [[ -n "$current" ]] || echo "No current release recorded in $releases/current"
}

# ---------------------------------------------------------------- installation
require_installation() {
    [[ -f "$SCRIPT_DIR/chain.env" && -f "$SCRIPT_DIR/compose.yml" ]] || {
        echo "ERROR: not an installed chain. From the repository run: deploy/chain/algo install <root>" >&2; exit 1; }
    ALGO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
    export ALGO_DATA ALGO_CONFIG ALGO_REPORTS
    ALGO_DATA="$(under "$ALGO_ROOT" data)"
    ALGO_CONFIG="$(under "$ALGO_ROOT" config)"
    ALGO_REPORTS="$(under "$ALGO_ROOT" reports)"
    LOGS="$(under "$ALGO_ROOT" logs)"
    SECRETS_FILE="$(under "$ALGO_ROOT" secrets)/chain.env"
    LOG_MODE="$(sed -n 's/^LOG_MODE=//p' "$SCRIPT_DIR/chain.env" | tail -n 1)"
    LOG_MODE="${LOG_MODE:-receiver}"
    [[ -r "$SECRETS_FILE" ]] || { echo "ERROR: cannot read $SECRETS_FILE (run as its owner or with sudo)" >&2; exit 1; }
    select_mode
}

# MODE in chain.env picks the execution venue. Exported values override chain.env.
#   paper: simulated exchange; trading state in data/.
#   live:  Kraken Futures gateway; trading state in data/live/ (own NATS, PostgreSQL,
#          market data, venue journal), so PAPER history is never mixed with real money.
select_mode() {
    local setting extra_profiles live_cash
    setting() { sed -n "s/^$1=//p" "$SCRIPT_DIR/chain.env" | tail -n 1; }
    MODE="$(setting MODE)"; MODE="${MODE:-paper}"
    extra_profiles="$(setting COMPOSE_PROFILES)"
    export ALGO_STATE ALGO_SECRETS COMPOSE_PROFILES DASHBOARD_RUNTIME_MODE DASHBOARD_EXECUTION_VENUE \
        DASHBOARD_VENUE_TARGET_ENVIRONMENT DASHBOARD_EXCHANGE_GATEWAY_MODE
    ALGO_SECRETS="$(under "$ALGO_ROOT" secrets)"
    case "$MODE" in
        paper)
            ALGO_STATE="$ALGO_DATA"
            DASHBOARD_RUNTIME_MODE=PAPER DASHBOARD_EXECUTION_VENUE=SIMULATED
            DASHBOARD_VENUE_TARGET_ENVIRONMENT=PAPER DASHBOARD_EXCHANGE_GATEWAY_MODE=backend ;;
        live)
            ALGO_STATE="$ALGO_DATA/live"
            DASHBOARD_RUNTIME_MODE=LIVE DASHBOARD_EXECUTION_VENUE=KRAKEN
            DASHBOARD_VENUE_TARGET_ENVIRONMENT=LIVE DASHBOARD_EXCHANGE_GATEWAY_MODE=venue
            [[ -r "$ALGO_SECRETS/kraken.env" ]] || {
                echo "ERROR: MODE=live needs $ALGO_SECRETS/kraken.env (trading key, no withdrawal permission; README)" >&2; exit 1; }
            [[ -n "$(setting LIVE_ACCOUNT_NAMESPACE)" ]] || {
                echo "ERROR: MODE=live needs LIVE_ACCOUNT_NAMESPACE in chain.env" >&2; exit 1; }
            # ExecutionState starts from the venue's USD balance, not the PAPER virtual cash.
            live_cash="$(setting LIVE_INITIAL_CASH)"
            [[ -n "$live_cash" ]] || { echo "ERROR: MODE=live needs LIVE_INITIAL_CASH (the Kraken USD balance) in chain.env" >&2; exit 1; }
            # Kraken rounds balances and entry prices; reconciliation accepts 0.50 USD of cash.
            # PAPER_COMPARISON_FILE stays as set: data/live/comparison is the Kraken LIVE study.
            export INITIAL_CASH="$live_cash" CASH_TOLERANCE_USD=0.5
            mkdir -p "$ALGO_STATE" ;;
        *) echo "ERROR: MODE must be paper or live, got '$MODE'" >&2; exit 1 ;;
    esac
    COMPOSE_PROFILES="$MODE${extra_profiles:+,$extra_profiles}"
}

# Both gateways must never run at once: one would keep sending the chain's orders to the
# other venue. Switch with "algo down" before changing MODE.
refuse_other_mode() {
    local name others
    if [[ "$MODE" == live ]]; then others="gateway sim-exchange"; else others="gateway-kraken"; fi
    for name in $others; do
        if [[ -n "$(docker ps -q -f "name=^${name}\$")" ]]; then
            echo "ERROR: '$name' from the other MODE is running. Set MODE back and run 'algo down'" \
                 "(or 'docker stop $name') before starting MODE=$MODE." >&2
            exit 1
        fi
    done
}

compose() {
    local files=(-f "$SCRIPT_DIR/compose.yml")
    [[ "$LOG_MODE" != local ]] || files+=(-f "$SCRIPT_DIR/compose.local.yml")
    docker compose --project-directory "$SCRIPT_DIR" --env-file "$SCRIPT_DIR/chain.env" \
        --env-file "$SECRETS_FILE" "${files[@]}" "$@"
}

systemd_unit_active() {
    command -v systemctl >/dev/null 2>&1 && systemctl is-active --quiet "$1" 2>/dev/null
}

receiver_listening() {
    (: > "/dev/tcp/127.0.0.1/$RECEIVER_PORT") 2>/dev/null
}

receiver_start() {
    if receiver_listening; then return 0; fi
    if systemd_unit_active algotrading-logs.service; then
        echo "ERROR: algotrading-logs.service is active but port $RECEIVER_PORT is closed" >&2; exit 1
    fi
    local state="$ALGO_DATA/receiver" config
    config="$state/rsyslog.conf"
    mkdir -p "$state" "$LOGS"
    # Same receiver as the VPS unit, with this installation's folders.
    sed -e "s#workDirectory=\"/data/receiver\"#workDirectory=\"$state\"#" \
        -e "s#/chain/logging/clean_daily_logs.py#$SCRIPT_DIR/logging/clean_daily_logs.py#" \
        -e "s#--root /logs #--root $LOGS #" \
        "$SCRIPT_DIR/logging/rsyslog.conf" > "$config"
    /usr/sbin/rsyslogd -N1 -f "$config" >/dev/null
    /usr/sbin/rsyslogd -i "$state/rsyslogd.pid" -f "$config"
    for _ in $(seq 1 50); do receiver_listening && { echo "Log receiver started ($LOGS)"; return 0; }; sleep 0.1; done
    echo "ERROR: log receiver did not start" >&2; exit 1
}

receiver_stop() {
    local pid_file="$ALGO_DATA/receiver/rsyslogd.pid"
    if [[ -f "$pid_file" ]] && kill "$(cat "$pid_file")" 2>/dev/null; then
        rm -f "$pid_file"; echo "Log receiver stopped"
    fi
}

monitor_start() {
    local pid_file="$ALGO_DATA/telemetry/monitor.pid"
    if systemd_unit_active algotrading-monitor.service; then return 0; fi
    if [[ -f "$pid_file" ]] && kill -0 "$(cat "$pid_file")" 2>/dev/null; then return 0; fi
    local log_capture=()
    [[ "$LOG_MODE" != local ]] || log_capture=(--log-root "$LOGS")
    # setsid: own session, so it survives the terminal (or WSL command) that started it.
    setsid nohup python3 "$SCRIPT_DIR/monitor.py" --project algotrading --output "$ALGO_DATA/telemetry/host.json" \
        --disk-path "$ALGO_ROOT" "${log_capture[@]}" > "$ALGO_DATA/telemetry/monitor.out" 2>&1 < /dev/null &
    echo $! > "$pid_file"
    # Wait for the first sample: confirms it runs (and lets it detach before this shell exits).
    for _ in $(seq 1 100); do
        [[ "$ALGO_DATA/telemetry/host.json" -nt "$pid_file" ]] && { echo "Host monitor started"; return 0; }
        kill -0 "$(cat "$pid_file")" 2>/dev/null || break
        sleep 0.2
    done
    echo "ERROR: host monitor did not start; see $ALGO_DATA/telemetry/monitor.out" >&2
    return 1
}

monitor_stop() {
    local pid_file="$ALGO_DATA/telemetry/monitor.pid"
    if [[ -f "$pid_file" ]] && kill "$(cat "$pid_file")" 2>/dev/null; then
        rm -f "$pid_file"; echo "Host monitor stopped"
    fi
}

mask_secrets() {
    sed -E -e 's/(password=)[^" ]+/\1********/g' \
           -e 's/((PASSWORD|TOKEN|CHAT_ID)[A-Z_]*: *)[^ ].*/\1********/g'
}

backup() {
    local stamp running archive
    stamp="$(date -u +%Y%m%d_%H%M%S)"
    archive="$(under "$ALGO_ROOT" backups)/$stamp.tar.gz"
    running="$(compose ps -q)"
    [[ -z "$running" ]] || compose stop
    # PostgreSQL files belong to container users; archive from a container.
    docker run --rm -v "$ALGO_DATA:/data:ro" -v "$(dirname "$archive"):/backups" alpine:3.20 \
        sh -c "tar -czf /backups/$stamp.tar.gz -C /data --exclude=./telemetry --exclude=./receiver . \
               && chown $(id -u):$(id -g) /backups/$stamp.tar.gz && chmod 0600 /backups/$stamp.tar.gz"
    [[ -z "$running" ]] || compose start
    echo "Backup written: $archive"
}

main() {
    local command="${1:-help}"; shift || true
    case "$command" in
        install) install_chain "$@" ;;
        build) build_images ;;
        release) make_release "$@" ;;
        activate) activate_release "$@" ;;
        help|-h|--help) usage ;;
        *)
            require_installation
            case "$command" in
                releases) list_releases ;;
                rollback) rollback_release ;;
                up)
                    refuse_other_mode
                    [[ "$LOG_MODE" == local ]] || receiver_start
                    compose up -d "$@"
                    [[ $# -gt 0 ]] || monitor_start ;;
                down)
                    if [[ $# -gt 0 ]]; then compose stop "$@"
                    else compose down; monitor_stop; systemd_unit_active algotrading-logs.service || receiver_stop; fi ;;
                restart) [[ $# -gt 0 ]] || { usage; exit 1; }; compose restart "$@" ;;
                ps)
                    compose ps -a
                    if [[ "$LOG_MODE" == local ]]; then echo "logs: local mode (host monitor copies container logs)"
                    elif receiver_listening; then echo "log receiver: listening on 127.0.0.1:$RECEIVER_PORT"; else echo "log receiver: STOPPED"; fi
                    if [[ -f "$ALGO_DATA/telemetry/monitor.pid" ]] && kill -0 "$(cat "$ALGO_DATA/telemetry/monitor.pid")" 2>/dev/null \
                       || systemd_unit_active algotrading-monitor.service; then echo "host monitor: running"; else echo "host monitor: STOPPED"; fi
                    if systemd_unit_active algotrading-kraken.service; then echo "kraken account monitor: running"
                    elif [[ -f "$(under "$ALGO_ROOT" secrets)/kraken_readonly.env" ]]; then echo "kraken account monitor: STOPPED"
                    else echo "kraken account monitor: not configured (no secrets/kraken_readonly.env)"; fi ;;
                logs)
                    service="${1:?Usage: algo logs <service> [-n N]}"; shift
                    lines=50; [[ "${1:-}" == "-n" ]] && lines="${2:?}"
                    tail -n "$lines" -F "$LOGS/$service/$(date -u +%Y%m%d).log" ;;
                show) compose config "$@" | mask_secrets ;;
                backup) backup ;;
                receiver) case "${1:-}" in start) receiver_start ;; stop) receiver_stop ;; *) usage; exit 1 ;; esac ;;
                monitor) case "${1:-}" in start) monitor_start ;; stop) monitor_stop ;; *) usage; exit 1 ;; esac ;;
                *) usage; exit 1 ;;
            esac ;;
    esac
}

# "activate"/"rollback" replace this file while it runs; bash has read this whole line
# before main starts, so it never reads the new file's bytes.
main "$@"; exit
