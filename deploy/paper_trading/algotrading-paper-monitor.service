[Unit]
Description=Paper stack host/container telemetry (read-only observation)
After=docker.service
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/opt/algotrading
ExecStart=/usr/bin/python3 /opt/algotrading/deploy/chain/monitor.py --project algotrading-paper --services nats,postgres,market-data,strategy,portfolio-risk,execution-state,order-planner,exchange-gateway,simulated-exchange,dashboard-api,dashboard-web,dashboard-watchdog,dashboard-alert-notifier --output /opt/algotrading/storage/paper_trading/telemetry/host.json --disk-path /opt/algotrading/storage
Restart=on-failure
RestartSec=10
# Docker inspection needs the Docker socket. This is a host-only service;
# the dashboard receives the JSON snapshot and never receives socket access.
User=root
UMask=0022
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/algotrading/storage/paper_trading/telemetry
PrivateTmp=true

[Install]
WantedBy=multi-user.target
