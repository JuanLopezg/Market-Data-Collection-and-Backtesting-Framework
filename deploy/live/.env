# LIVE infrastructure. Copy to deploy/live/.env and replace the password.
POSTGRES_DB=algotrading
POSTGRES_USER=algotrading
POSTGRES_PASSWORD=CHANGE_ME_BEFORE_LIVE

# Host-side canonical market-data directory. The market-data service is the only writer.
MARKET_DATA_DIR=../../storage/databases

# Host-local inspection ports. Service-to-service traffic uses Docker DNS.
LIVE_NATS_PORT=4222
LIVE_NATS_MONITOR_PORT=8222
LIVE_POSTGRES_PORT=5432

# Service configuration.
STRATEGY_CONFIG=/opt/algotrading/config/strategies/pure_rsi_signal.json
PORTFOLIO_CONFIG=/opt/algotrading/config/portfolio/pure_rsi_equal_weight.json
INITIAL_CASH=100000
MARKET_WARMUP_DAYS=100
MARKET_TOP_N=50
MARKET_HISTORY_BUFFER_DAYS=5

# Logging only. No replay clock/simulation variables belong in LIVE.
ALGOTRADING_LOG_DEBUG=0
ALGOTRADING_LOG_QUIET=0
ALGOTRADING_LOG_DIR=
