# Isolated historical replay infrastructure.
POSTGRES_DB=algotrading_historical_replay
POSTGRES_USER=algotrading
POSTGRES_PASSWORD=CHANGE_ME_FOR_REPLAY

# Host-local inspection ports; deliberately different from LIVE and legacy replay defaults.
HISTORICAL_REPLAY_NATS_PORT=64228
HISTORICAL_REPLAY_NATS_MONITOR_PORT=65228
HISTORICAL_REPLAY_POSTGRES_PORT=65438

# Historical source consumed only by the replay feeder.
HISTORICAL_DATA_PATH=../../storage/databases/1d_cmc.csv
HISTORICAL_MARKET_DATA_SOURCE=historical-cmc
# Intentionally high: the feeder ranks every symbol present that day so the
# strategy's own top-N liquidity universe is computed from the full dataset.
HISTORICAL_MARKET_TOP_N=1000000

STRATEGY_CONFIG=/opt/algotrading/config/strategies/pure_rsi_signal.json
PORTFOLIO_CONFIG=/opt/algotrading/config/portfolio/pure_rsi_equal_weight.json
INITIAL_CASH=100000
COMMISSION_RATE=0.0
MARKET_WARMUP_DAYS=100
MARKET_HISTORY_BUFFER_DAYS=5

ALGOTRADING_LOG_DEBUG=0
ALGOTRADING_LOG_QUIET=0
ALGOTRADING_LOG_DIR=
