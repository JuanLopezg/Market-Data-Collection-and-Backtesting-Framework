# EXAMPLE ONLY. For a real replay run, generate one file once with:
#   python3 tools/historical_replay/create_time_env.py \
#     --speed 100 \
#     --simulated-reference 2020-01-01T00:00:00Z \
#     --output /path/to/replay-time.env
#
# Every business container in the run must receive byte-for-byte equivalent values.
ALGOTRADING_TIME_SPEED=100
ALGOTRADING_TIME_REAL_REFERENCE_UTC=2026-09-20T13:00:00Z
ALGOTRADING_TIME_SIMULATED_REFERENCE_UTC=2020-01-01T00:00:00Z
