# Historical source visible ONLY to market-data-service.
HISTORICAL_DATA_PATH=../../storage/databases/1d_cmc.csv

REPLAY_START_DATE=2024-01-01
REPLAY_END_DATE=2024-01-03
REPLAY_BARRIER_TIMEOUT_MS=60000

# Localhost-only debug/inspection ports. Service-to-service traffic uses Docker DNS.
REPLAY_NATS_PORT=54228
REPLAY_NATS_MONITOR_PORT=58228
REPLAY_POSTGRES_PORT=55438

# REPLAY-only logical clock pacing. LIVE/TESTNET do not consume these settings.
# max = event-driven. x1 = real-time mapping. x10/x60/x100/... = accelerated.
REPLAY_CLOCK_SPEED=max
# Wall-time scale defaults to true time. Use <1 only for compressed validation/demo runs.
REPLAY_CLOCK_WALL_SCALE=1.0
