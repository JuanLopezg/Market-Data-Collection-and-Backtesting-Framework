# In-process behaviour tests, one folder per area.
foreach area : [
    'utils', 'market', 'indicators', 'strategy', 'risk', 'planning', 'execution',
    'mock_exchange', 'adapters', 'accounting', 'persistence', 'transport', 'runtime',
    'market_data_service', 'execution_state_service', 'exchange_gateway',
]
    subdir(area)
endforeach
