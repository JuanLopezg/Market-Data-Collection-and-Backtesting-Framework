{
  admin off
}

# Keep a tiny plain-HTTP health endpoint for the container healthcheck.
# Every other HTTP request is redirected to HTTPS.
http:// {
  @health path /health
  respond @health "ok" 200
  redir https://{$DASHBOARD_DOMAIN}{uri} permanent
}

{$DASHBOARD_DOMAIN} {
  header {
    -Server
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
    Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'"
  }

  @health path /health
  respond @health "ok" 200

  # Long-lived authenticated SSE response. Disable reverse-proxy buffering and
  # do not put the stream through response compression.
  handle /api/stream {
    reverse_proxy dashboard-api:8080 {
      flush_interval -1
      transport http {
        dial_timeout 2s
        response_header_timeout 8s
      }
    }
  }

  handle /api/* {
    reverse_proxy dashboard-api:8080 {
      transport http {
        dial_timeout 2s
        response_header_timeout 8s
      }
    }
  }

  handle {
    encode zstd gzip
    root * /srv
    try_files {path} /index.html

    @assets path /assets/*
    header @assets Cache-Control "public, max-age=31536000, immutable"
    header /index.html Cache-Control "no-cache"

    file_server
  }
}
