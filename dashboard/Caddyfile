:80 {
  # SSE must not be response-compressed/buffered or browser invalidations can
  # arrive in batches instead of immediately.
  handle /api/stream {
    reverse_proxy dashboard-api:8080 {
      flush_interval -1
    }
  }

  handle /api/* {
    reverse_proxy dashboard-api:8080
  }

  handle {
    encode zstd gzip
    root * /srv
    try_files {path} /index.html
    file_server

    @assets path /assets/*
    header @assets Cache-Control "public, max-age=31536000, immutable"
    # `header` runs before try_files, so "/" and SPA routes (e.g. /execution) are matched
    # here by their original path: everything outside /assets must be revalidated, or
    # browsers keep an old index.html that points at an old bundle.
    @app not path /assets/*
    header @app Cache-Control "no-cache"
  }
}
