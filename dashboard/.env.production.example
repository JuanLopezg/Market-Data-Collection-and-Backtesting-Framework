# Step 30 production template. Copy to .env.production on the VPS.
# Never commit the real file.

# Public hostname. DNS A/AAAA must point to the VPS before Caddy can issue TLS.
DASHBOARD_DOMAIN=dashboard.example.com

# Dashboard authentication. Use different long random secrets.
DASHBOARD_VIEWER_USERNAME=viewer
DASHBOARD_VIEWER_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_SECRET
DASHBOARD_OPERATOR_USERNAME=operator
DASHBOARD_OPERATOR_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET
DASHBOARD_SESSION_TTL=8h

# Production must use the real provider for operational data.
DASHBOARD_DATA_PROVIDER=real
DASHBOARD_RUNTIME_MODE=LIVE

# Read-only PostgreSQL connection used by dashboard-api.
# Prefer a dedicated DB role with SELECT only when you create one.
DASHBOARD_POSTGRES_DSN=host=postgres port=5432 dbname=algotrading user=algotrading password=REPLACE_WITH_POSTGRES_PASSWORD sslmode=disable

# Internal NATS endpoints. These are reached through the trading Docker network,
# not published by the dashboard.
DASHBOARD_NATS_URL=nats://nats:4222
DASHBOARD_NATS_MONITOR_URL=http://nats:8222
DASHBOARD_NATS_STREAM=ALGOTRADING_RUNTIME
ALGOTRADING_LIVE_NETWORK=algotrading-live_live

# Host paths on the VPS. Use absolute paths.
DASHBOARD_MARKET_DATA_HOST_DIR=/opt/algotrading/storage/databases
DASHBOARD_MARKET_DATA_DB_HOST_FILE=/opt/algotrading/storage/databases/database.db
DASHBOARD_MARKET_TOP_N=50
DASHBOARD_MARKET_HISTORY_DAYS=100
DASHBOARD_STRATEGY_UNIVERSE_N=20
DASHBOARD_SOURCE_PROBE_TIMEOUT=1s

# Step 33/34 target venue boundary. Identity is fixed to TESTNET and Step 34
# permits public metadata connectivity only; no credentials/signing/order routing.
DASHBOARD_EXECUTION_VENUE=HYPERLIQUID
DASHBOARD_VENUE_TARGET_ENVIRONMENT=TESTNET
DASHBOARD_EXCHANGE_GATEWAY_MODE=hyperliquid-dry-run
DASHBOARD_HYPERLIQUID_PUBLIC_INFO_URL=https://api.hyperliquid-testnet.xyz/info
DASHBOARD_HYPERLIQUID_PUBLIC_TIMEOUT=3s

# Dashboard-process resilience limits.
DASHBOARD_RESOURCE_TIMEOUT=7s
DASHBOARD_SSE_MAX_CLIENTS=16

# Frontend values are public build-time configuration; never place secrets here.
VITE_DASHBOARD_DATA_MODE=api
VITE_DASHBOARD_API_BASE_URL=/api
VITE_DASHBOARD_API_TIMEOUT_MS=8000
