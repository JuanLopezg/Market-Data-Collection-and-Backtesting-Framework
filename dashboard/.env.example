# Direct Vite development defaults to mocks. No backend is required.
# Mock mode auto-enters as mock-operator; after signing out use viewer/demo or operator/demo.
VITE_DASHBOARD_DATA_MODE=mock
VITE_DASHBOARD_API_BASE_URL=/api
VITE_DASHBOARD_API_TIMEOUT_MS=8000
VITE_DASHBOARD_MOCK_LATENCY_MS=80

# dashboard-api (when run separately)
DASHBOARD_DATA_PROVIDER=mock

# Step 14 verified real-source hints (unused while DASHBOARD_DATA_PROVIDER=mock)
DASHBOARD_POSTGRES_DSN=
DASHBOARD_NATS_URL=
DASHBOARD_NATS_STREAM=ALGOTRADING_RUNTIME
DASHBOARD_MARKET_DATA_DB=

# Step 29 dashboard resilience limits
DASHBOARD_RESOURCE_TIMEOUT=7s
DASHBOARD_SSE_MAX_CLIENTS=16

# Step 33/34 testnet boundary: identity + public metadata only; no secrets/signing/orders.
DASHBOARD_EXECUTION_VENUE=HYPERLIQUID
DASHBOARD_VENUE_TARGET_ENVIRONMENT=TESTNET
DASHBOARD_EXCHANGE_GATEWAY_MODE=hyperliquid-dry-run
DASHBOARD_HYPERLIQUID_PUBLIC_INFO_URL=https://api.hyperliquid-testnet.xyz/info
DASHBOARD_HYPERLIQUID_PUBLIC_TIMEOUT=3s

# Step 46C alert notifier. TEST_FILE remains the safe default. Set TELEGRAM only
# through deployment env/secret files; never commit or paste real bot credentials.
DASHBOARD_NOTIFIER_SINK=TEST_FILE
DASHBOARD_NOTIFIER_MIN_SEVERITY=WARN
DASHBOARD_NOTIFIER_INTERVAL=5s
DASHBOARD_NOTIFIER_COOLDOWN=5m
DASHBOARD_NOTIFIER_SWEEP_TIMEOUT=10s
DASHBOARD_NOTIFIER_SOURCE_MAX_BYTES=67108864
DASHBOARD_TELEGRAM_BOT_TOKEN=
DASHBOARD_TELEGRAM_BOT_TOKEN_FILE=
DASHBOARD_TELEGRAM_CHAT_ID=
DASHBOARD_TELEGRAM_CHAT_ID_FILE=
DASHBOARD_TELEGRAM_RECEIPT_FILE=
DASHBOARD_TELEGRAM_REQUEST_TIMEOUT=8s
