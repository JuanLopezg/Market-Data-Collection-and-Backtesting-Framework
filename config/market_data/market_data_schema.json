{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MarketDataConfig",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "main_exchange": {
      "const": "binance"
    },
    "database_path": {
      "type": "string",
      "minLength": 1
    },
    "binance_base_url": {
      "type": "string",
      "minLength": 1
    },
    "nats_url": {
      "type": "string",
      "minLength": 1
    },
    "stream": {
      "type": "string",
      "minLength": 1
    },
    "ranking_size": {
      "type": "integer",
      "minimum": 50,
      "maximum": 1000
    },
    "active_top_n": {
      "type": "integer",
      "minimum": 1
    },
    "retain_after_top_n_days": {
      "type": "integer",
      "minimum": 1
    },
    "minimum_history_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1500
    },
    "max_parallel_requests": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "midnight_delay_seconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 300
    },
    "retry_after_failure_seconds": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "main_exchange",
    "database_path",
    "binance_base_url",
    "nats_url",
    "stream",
    "ranking_size",
    "active_top_n",
    "retain_after_top_n_days",
    "minimum_history_days"
  ]
}
